# Puerto donde escucha la API
PORT=4000

# Clave que la app Flutter debe enviar en el header "x-api-key"
# Tiene que ser IDENTICA a la que se hardcodea en lib/config.dart de la app
API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Carpeta en este VPS donde se guardan los backups, organizados por cliente:
# BACKUP_DEST_DIR/<clientId>/<archivo>.zip
BACKUP_DEST_DIR=/var/backups/fg-backups

# Cuantos dias de backups conservar por cliente antes de borrar los mas viejos.
# Excepcion: el ultimo backup de cada mes (por carpeta) se conserva siempre.
RETENTION_DAYS=30
