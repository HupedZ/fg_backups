# Puerto donde escucha la API
PORT=4000

# Clave que la app Flutter debe enviar en el header "x-api-key"
API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Datos de la maquina origen desde la que se jala el backup por SSH/rsync
SOURCE_USER=usuario
SOURCE_HOST=origen.example.com
SOURCE_PATH=/ruta/a/la/carpeta/a/respaldar
SSH_KEY_PATH=/root/.ssh/id_rsa_backup

# Carpeta en este VPS donde se guardan los backups (uno por fecha)
BACKUP_DEST_DIR=/var/backups/fg-backups

# Cuantos dias de backups conservar antes de borrar los mas viejos
RETENTION_DAYS=30

# Horario del backup diario (formato cron). Por defecto 3:00 am
CRON_SCHEDULE=0 3 * * *
